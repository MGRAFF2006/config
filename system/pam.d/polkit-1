#%PAM-1.0
# Managed by Documents/config/scripts/install-howdy-polkit.py (explicit opt-in;
# install-pam-keyring-howdy.sh does not install this stack).
# The polkit helper also needs the managed camera and lockout-state drop-in.
#
# Password first, like greetd and the lock screen. Quickshell starts PAM as
# soon as a request arrives, so nothing here may approve it before the user
# answers this request's prompt. The first line asks for the password (kept
# as PAM_AUTHTOK) and succeeds only when cmp has read that answer and found it
# empty (Enter or Authenticate on the empty field). Anything else, a typed
# password or any pam_exec or cmp error (PAM_SYSTEM_ERR either way), goes to
# system-auth, which alone decides with the answer as the password. An error
# can therefore never send a typed password to the face path.
# The face path fails closed unless system-auth still matches the copy that
# install-howdy-polkit.py validated (every auth step it skips is a password or
# lockout step), then runs the lockout guard, so a locked account stays denied.
# A cancelled dialog ends the conversation with an error and stops here.

auth       [success=1 system_err=ignore default=die]  pam_exec.so quiet quiet_log expose_authtok /usr/bin/cmp -s /dev/null -
auth       [success=4 default=die]      pam_permit.so
auth       requisite                    pam_exec.so quiet /usr/bin/sha256sum --check --status --strict /etc/howdy/polkit-system-auth.sha256
auth       requisite                    pam_faillock.so      preauth
auth       sufficient                   pam_howdy.so
auth       requisite                    pam_deny.so
auth       include                      system-auth
account    include                      system-auth
password   include                      system-auth
session    include                      system-auth
