#%PAM-1.0
# Managed by Documents/config/scripts/install-pam-keyring-howdy.sh
# Password/PIN first, so a typed secret never waits for the camera; submitting
# an empty password falls through to Howdy. greetd runs one PAM service per
# login attempt, so Howdy first would let a stalled camera block password login.
# Use success=N (not "sufficient") so pam_kwallet5 still runs afterward.
# The guards are requisite so nothing after pam_deny runs unless every earlier
# step succeeded: a remembered "required" failure would still reach it.
# install-howdy-kwallet-tpm.py (held, explicit opt-in) adds a TPM token
# supplier right after pam_deny; this file never loads it.

auth       requisite                    pam_securetty.so
auth       requisite                    pam_nologin.so
auth       [success=2 default=ignore]   pam_unix.so          try_first_pass nullok
auth       [success=1 default=ignore]   pam_howdy.so
auth       requisite                    pam_deny.so
-auth      optional                     pam_kwallet5.so

account    include                      system-local-login

password   include                      system-local-login

session    include                      system-local-login
-session   optional                     pam_kwallet5.so auto_start force_run kwalletd=/usr/bin/ksecretd
