@@ -130,0 +151,39 @@
+static long elapsed_ms(const struct timespec *start)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (now.tv_sec - start->tv_sec) * 1000L +
+	       (now.tv_nsec - start->tv_nsec) / 1000000L;
+}
+
+/*
+ * Reap the child, killing it once the deadline passes. Give up after a short
+ * grace rather than block login on a child that cannot exit.
+ */
+static int reap_child(pid_t pid, int *status, const struct timespec *start)
+{
+	const struct timespec pause = { 0, 10 * 1000000L };
+	long limit = DEADLINE_MS;
+	int killed = 0;
+
+	for (;;) {
+		pid_t waited = waitpid(pid, status, WNOHANG);
+
+		if (waited == pid)
+			return killed ? -1 : 0;
+		if (waited < 0 && errno != EINTR)
+			return -1;
+		if (elapsed_ms(start) >= limit) {
+			if (killed)
+				return -1;
+			/* timeout(1) leads its own process group. */
+			kill(-pid, SIGKILL);
+			kill(pid, SIGKILL);
+			killed = 1;
+			limit = elapsed_ms(start) + REAP_GRACE_MS;
+		}
+		nanosleep(&pause, NULL);
+	}
+}
