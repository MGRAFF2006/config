#!/usr/bin/env python3
"""Emit current NetworkManager diagnostics as one JSON object."""

from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor
import json
import math
import os
from pathlib import Path
import re
import subprocess
import tempfile
import time
from typing import Any


NET_PATH = Path("/sys/class/net")
SAMPLE_PATH = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "dms-network-sample.json"


def run(command: list[str], timeout: float = 3) -> tuple[str, int]:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    try:
        result = subprocess.run(
            command,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            env=env,
        )
        return result.stdout.strip(), result.returncode
    except (OSError, subprocess.TimeoutExpired):
        return "", 1


def split_escaped(value: str, separator: str = ":") -> list[str]:
    parts: list[str] = []
    current: list[str] = []
    escaped = False
    for character in value:
        if escaped:
            current.append(character)
            escaped = False
        elif character == "\\":
            escaped = True
        elif character == separator:
            parts.append("".join(current))
            current = []
        else:
            current.append(character)
    parts.append("".join(current))
    return parts


def active_device(preferred_device: str = "") -> tuple[str, str] | None:
    output, code = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", "status"])
    if code != 0:
        return None
    candidates: list[tuple[str, str]] = []
    for line in output.splitlines():
        fields = split_escaped(line)
        if len(fields) < 3 or not fields[2].startswith("connected"):
            continue
        if fields[1] in ("wifi", "ethernet"):
            candidates.append((fields[0], fields[1]))
    if preferred_device:
        for candidate in candidates:
            if candidate[0] == preferred_device:
                return candidate
        raise ValueError("Requested interface " + preferred_device +
                         " is not a connected Wi-Fi or Ethernet device. Refresh network status.")
    if not candidates:
        return ("", "")
    # Prefer the physical interface carrying a default route, including IPv6-only links.
    route_metrics: dict[str, int] = {}
    for family in ("-4", "-6"):
        routes, route_code = run(["ip", "-j", family, "route", "show", "default"])
        if route_code != 0:
            continue
        try:
            for route in json.loads(routes):
                device = route.get("dev", "")
                metric = int(route.get("metric", 0))
                route_metrics[device] = min(metric, route_metrics.get(device, metric))
        except (json.JSONDecodeError, TypeError, ValueError, AttributeError):
            continue
    candidates.sort(key=lambda item: (item[0] not in route_metrics,
                                      route_metrics.get(item[0], 0), item[1] != "ethernet"))
    return candidates[0]


def device_details(device: str) -> tuple[dict[str, list[str]], bool]:
    fields = "GENERAL.CONNECTION,GENERAL.DEVICE,GENERAL.TYPE,GENERAL.HWADDR,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,IP6.ADDRESS,IP6.GATEWAY,IP6.DNS"
    output, code = run(["nmcli", "-t", "-f", fields, "device", "show", device])
    result: dict[str, list[str]] = {}
    for line in output.splitlines():
        key_value = split_escaped(line)
        if len(key_value) < 2:
            continue
        key = re.sub(r"\[\d+\]$", "", key_value[0])
        value = ":".join(key_value[1:])
        if value and value != "--":
            result.setdefault(key, []).append(value)
    return result, code == 0


def first(details: dict[str, list[str]], key: str) -> str:
    values = details.get(key, [])
    return values[0] if values else ""


def wifi_details(device: str) -> dict[str, Any]:
    output, _ = run(
        [
            "nmcli",
            "-t",
            "-f",
            "IN-USE,SSID,SIGNAL,RATE,SECURITY",
            "device",
            "wifi",
            "list",
            "ifname",
            device,
            "--rescan",
            "no",
        ]
    )
    for line in output.splitlines():
        fields = split_escaped(line)
        if len(fields) >= 5 and fields[0] == "*":
            return {
                "ssid": fields[1],
                "signal": int(fields[2]) if fields[2].isdigit() else 0,
                "rate": fields[3],
                "security": fields[4],
            }
    return {"ssid": "", "signal": 0, "rate": "", "security": ""}


def connectivity() -> str:
    # This reads NetworkManager's cached assessment; it never starts a connectivity check.
    output, code = run(["nmcli", "-g", "CONNECTIVITY", "general"])
    state = output.lower()
    return state if code == 0 and state in ("full", "limited", "portal", "none") else "unknown"


def ping_ms(host: str) -> float | None:
    if not host:
        return None
    output, code = run(["/usr/bin/ping", "-n", "-c", "1", "-W", "1", host], timeout=2)
    if code != 0:
        return None
    match = re.search(r"time[=<]([\d.]+)\s*ms", output)
    return round(float(match.group(1)), 1) if match else None


def dns_ms() -> float | None:
    started = time.monotonic()
    _, code = run(["resolvectl", "query", "--legend=no", "example.com"], timeout=2)
    if code != 0:
        return None
    return round((time.monotonic() - started) * 1000, 1)


def network_rates(device: str) -> tuple[float, float]:
    now = time.monotonic()
    try:
        rx = int((NET_PATH / device / "statistics/rx_bytes").read_text())
        tx = int((NET_PATH / device / "statistics/tx_bytes").read_text())
    except (OSError, ValueError):
        return (0.0, 0.0)

    previous: dict[str, Any] = {}
    try:
        value = json.loads(SAMPLE_PATH.read_text())
        if isinstance(value, dict):
            previous = value
    except (OSError, json.JSONDecodeError):
        pass

    down, up = 0.0, 0.0
    try:
        elapsed = now - float(previous["time"])
        old_rx, old_tx = int(previous["rx"]), int(previous["tx"])
        if (previous.get("device") == device and math.isfinite(elapsed)
                and 0 < elapsed <= 30 and 0 <= old_rx <= rx and 0 <= old_tx <= tx):
            down = (rx - old_rx) / elapsed
            up = (tx - old_tx) / elapsed
    except (KeyError, TypeError, ValueError, OverflowError):
        pass

    SAMPLE_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=SAMPLE_PATH.name + ".", dir=SAMPLE_PATH.parent)
    try:
        with os.fdopen(fd, "w") as file:
            json.dump({"device": device, "time": now, "rx": rx, "tx": tx, "down": down, "up": up}, file)
        os.replace(temporary, SAMPLE_PATH)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return (down, up)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--interface", default="", help="Sample this connected Wi-Fi or Ethernet interface")
    args = parser.parse_args(argv)
    state = connectivity()
    try:
        active = active_device(args.interface)
    except ValueError as error:
        print(json.dumps({"connected": None, "connectivity": state, "error": str(error)}, separators=(",", ":")))
        return 0
    if active is None:
        print(json.dumps({"connected": None, "connectivity": state,
                          "error": "Could not read NetworkManager device status. Retry or check NetworkManager."},
                         separators=(",", ":")))
        return 0
    device, connection_type = active
    if not device:
        print(json.dumps({"connected": False, "connectivity": state}, separators=(",", ":")))
        return 0

    details, details_ok = device_details(device)
    connection = first(details, "GENERAL.CONNECTION")
    wifi = wifi_details(device) if connection_type == "wifi" else {}
    gateway = first(details, "IP4.GATEWAY") or first(details, "IP6.GATEWAY")
    probe_gateway = gateway
    if ":" in gateway and "%" not in gateway:
        probe_gateway += "%" + device
    internet_target = "1.1.1.1" if details.get("IP4.ADDRESS") else "2606:4700:4700::1111"
    with ThreadPoolExecutor(max_workers=3) as probes:
        gateway_probe = probes.submit(ping_ms, probe_gateway)
        internet_probe = probes.submit(ping_ms, internet_target)
        dns_probe = probes.submit(dns_ms)
        gateway_ping, internet_ping, dns_lookup = gateway_probe.result(), internet_probe.result(), dns_probe.result()
    down, up = network_rates(device)
    result = {
        "connected": True,
        "connectivity": state,
        "type": connection_type,
        "connection": connection,
        "ssid": wifi.get("ssid", "") or connection,
        "signal": wifi.get("signal", 0),
        "linkRate": wifi.get("rate", ""),
        "security": wifi.get("security", ""),
        "interface": device,
        "mac": first(details, "GENERAL.HWADDR"),
        "addresses": details.get("IP4.ADDRESS", []) + details.get("IP6.ADDRESS", []),
        "gateway": gateway,
        "dnsServers": details.get("IP4.DNS", []) + details.get("IP6.DNS", []),
        "gatewayPingMs": gateway_ping,
        "internetPingMs": internet_ping,
        "dnsLookupMs": dns_lookup,
        "downloadBytesPerSecond": round(down),
        "uploadBytesPerSecond": round(up),
    }
    if not details_ok:
        result["error"] = "Could not read NetworkManager details for " + device + ". Retry or check NetworkManager."
    print(json.dumps(result, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
