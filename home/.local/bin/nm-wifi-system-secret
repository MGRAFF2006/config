#!/usr/bin/env bash
# Store a WiFi (or 802.1x) password in the NetworkManager system connection
# file instead of an agent-owned keyring entry.
# Usage:
#   nm-wifi-system-secret "SSID"
#   nm-wifi-system-secret "SSID" --ask   # prompt for password
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <connection-name> [--ask]" >&2
  exit 2
fi

name=$1
ask=${2:-}

if ! nmcli -t -f NAME connection show | grep -Fxq "$name"; then
  echo "No NetworkManager connection named: $name" >&2
  exit 1
fi

keymgmt=$(nmcli -g 802-11-wireless-security.key-mgmt connection show "$name" 2>/dev/null || true)

nmcli connection modify "$name" connection.permissions ""

if [[ "$keymgmt" == "wpa-eap" ]]; then
  if [[ "$ask" == "--ask" ]]; then
    read -r -s -p "802.1x password for $name: " pw
    echo
  else
    read -r -s -p "802.1x password for $name: " pw
    echo
  fi
  nmcli connection modify "$name" 802-1x.password-flags 0
  nmcli connection modify "$name" 802-1x.password "$pw"
else
  if [[ "$ask" == "--ask" ]]; then
    read -r -s -p "WiFi password for $name: " pw
    echo
  else
    read -r -s -p "WiFi password for $name: " pw
    echo
  fi
  nmcli connection modify "$name" 802-11-wireless-security.psk-flags 0
  nmcli connection modify "$name" 802-11-wireless-security.psk "$pw"
fi

unset pw
echo "Stored system secret for: $name"
nmcli -f connection.id,connection.permissions,802-11-wireless-security.psk-flags,802-1x.password-flags connection show "$name" | head -20
