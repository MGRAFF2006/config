/**
 * Nord Clean Theme for Rofi
 * Minimal, solid, fast -- no transparency gimmicks
 * Nord palette matched to dwm bar
 */

* {
    nord0:  #2e3440;
    nord1:  #3b4252;
    nord2:  #434c5e;
    nord3:  #4c566a;
    nord4:  #d8dee9;
    nord5:  #e5e9f0;
    nord6:  #eceff4;
    nord7:  #8fbcbb;
    nord8:  #88c0d0;
    nord9:  #81a1c1;
    nord10: #5e81ac;
    nord11: #bf616a;
    nord14: #a3be8c;
    nord15: #b48ead;

    bg:     @nord0;
    bg-alt: @nord1;
    fg:     @nord4;
    fg-dim: @nord3;
    accent: @nord8;
    urgent: @nord11;

    background-color: transparent;
    text-color:       @fg;
    font:             "MesloLGS Nerd Font Mono 14";
}

window {
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: @bg;
    border:           2px;
    border-color:     @nord2;
    border-radius:    0px;
    padding:          0;
}

mainbox {
    background-color: @bg;
    children:         [ inputbar, listview, mode-switcher ];
    spacing:          0;
    padding:          0;
}

/* --- Input --- */

inputbar {
    background-color: @bg-alt;
    text-color:       @fg;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: inherit;
    text-color:       @accent;
}

entry {
    background-color: inherit;
    text-color:       @fg;
    placeholder:      "Search...";
    placeholder-color: @fg-dim;
    cursor-color:     @accent;
}

/* --- List --- */

listview {
    background-color: @bg;
    columns:          1;
    lines:            10;
    spacing:          0;
    padding:          4px 0;
    scrollbar:        false;
    fixed-height:     true;
    border:           0;
    cycle:            true;
    dynamic:          true;
    require-input:    true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 16px;
    spacing:          10px;
}

element selected.normal {
    background-color: @nord2;
    text-color:       @nord6;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @nord6;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element selected.active {
    background-color: @nord2;
    text-color:       @accent;
}

element-icon {
    background-color: inherit;
    text-color:       inherit;
    size:             22px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    highlight:        bold;
}

/* --- Mode Switcher --- */

mode-switcher {
    background-color: @bg-alt;
    border:           0;
    padding:          6px 10px;
    spacing:          6px;
}

button {
    background-color: transparent;
    text-color:       @fg-dim;
    padding:          4px 10px;
    font:             "MesloLGS Nerd Font Mono 11";
}

button selected {
    background-color: @nord2;
    text-color:       @accent;
}

/* --- Message --- */

message {
    background-color: @bg;
    padding:          8px 16px;
}

textbox {
    background-color: inherit;
    text-color:       @fg-dim;
    font:             "MesloLGS Nerd Font Mono 11";
}

scrollbar {
    background-color: @bg;
    handle-color:     @nord3;
    handle-width:     4px;
}
