[Unit]
Description=KDE Secret Service + kwallet-pam socket (Hyprland)
Documentation=file:///home/humunkulud/Documents/config/docs/hyprland-dms.md
PartOf=hyprland-session.target
After=graphical-session-pre.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/ksecretd
ExecStartPost=/usr/lib/pam_kwallet_init
Restart=on-failure
RestartSec=1
Slice=background.slice

[Install]
WantedBy=hyprland-session.target
