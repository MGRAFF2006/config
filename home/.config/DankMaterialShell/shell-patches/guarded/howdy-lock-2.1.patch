+    // Howdy on the lock screen. The managed stack asks for the password before
+    // Howdy, so a typed password never waits for the camera. A face attempt
+    // answers that first prompt with an empty response, which falls through to
+    // Howdy. One starts automatically per wake: the display turning back on, a
+    // resume from sleep, or a key press or click on the lock screen. Locking
+    // alone, or a suspend that was requested but never happened, does not start
+    // the camera, so the person still in front of a lit screen stays locked.
+    // Enter on the empty field starts one too, or keeps the running one. A face
+    // attempt never makes authBusy, so the password field keeps taking keys;
+    // the first edit abandons it and the password goes to a fresh attempt.
+    property bool howdyArmed: false
+    property bool howdyAutoStarted: false
+    property bool howdyFaceAttempt: false
+    // Enter asked for this face attempt, so its failure is reported. Automatic
+    // attempts end silently when no face matches.
+    property bool howdyFaceRequested: false
+    // Set once the empty answer is sent. A face-attempt success before that
+    // came from a module that accepted no input (pam_unix nullok on a blank
+    // password), not from Howdy, and must not unlock.
+    property bool howdyFaceAnswered: false
+    readonly property bool howdyScreenInactive: SessionService.preparingForSleep
+        || SessionService.sleepRequested || IdleService.monitorsOff
+    readonly property bool howdyStackReady: !AdminPolicy.disableCustomLockPam
+        && SettingsData.lockPamExternallyManaged
+        && SettingsData.lockPamPath === "/etc/pam.d/dankshell"
+        && root.customPamActive
+        && /^[ \t]*auth[ \t][^\n]*\bpam_unix\.so\b[\s\S]*^[ \t]*auth[ \t][^\n]*\bpam_howdy\.so\b/m.test(customPamWatcher.text())
+    readonly property bool howdyFaceAvailable: root.lockSecured && root.howdyStackReady
+        && !root.unlockInProgress && !root.u2fPending && !root.howdyScreenInactive
+    readonly property bool howdyAutoReady: root.howdyFaceAvailable && root.howdyArmed
+        && !root.buffer && !root.responseSubmitted
+
+    function armHowdy(): void {
+        if (root.lockSecured)
+            root.howdyArmed = true;
+    }
+
+    function startHowdyFace(): void {
+        root.howdyAutoStarted = true;
+        root.howdyFaceAttempt = true;
+        root.howdyFaceAnswered = false;
+        root.responseSubmitted = true;
+        if (!passwd.start()) {
+            root.howdyFaceAttempt = false;
+            root.howdyFaceRequested = false;
+            root.responseSubmitted = false;
+        }
+    }
+
+    function abandonHowdyAuto(): void {
+        if (!root.howdyFaceAttempt)
+            return;
+        root.howdyFaceAttempt = false;
+        root.howdyFaceRequested = false;
+        root.howdyFaceAnswered = false;
+        root.responseSubmitted = false;
+        passwd.abort();
+    }
+
+    onBufferChanged: {
+        if (root.buffer)
+            root.abandonHowdyAuto();
+    }
+
+    onHowdyScreenInactiveChanged: {
+        if (!howdyScreenInactive)
+            return;
+        // Disarm until the next real wake. A typed or submitted password and a
+        // pending second factor belong to manual attempts and are kept.
+        if (!root.unlockInProgress && !root.u2fPending)
+            root.abandonHowdyAuto();
+        root.howdyArmed = false;
+        root.howdyAutoStarted = false;
+    }
+
+    // Only the display turning back on or a resume arm the automatic attempt.
+    // A refused suspend clears sleepRequested after DMS's request timeout with
+    // neither, while the display is still on, and stays a start guard only.
+    Connections {
+        target: IdleService
+
+        function onMonitorsOffChanged() {
+            if (!IdleService.monitorsOff)
+                root.armHowdy();
+        }
+    }
+
+    Connections {
+        target: SessionService
+
+        function onPreparingForSleepChanged() {
+            if (!SessionService.preparingForSleep)
+                root.armHowdy();
+        }
+    }
+
+    onHowdyAutoReadyChanged: {
+        if (howdyAutoReady && !howdyAutoStarted && !passwd.active) {
+            // Runs after the lock transition's PAM reset and after a key press
+            // has reached the password field; typed text cancels the attempt.
+            Qt.callLater(() => {
+                if (!root.howdyAutoReady || root.howdyAutoStarted || passwd.active)
+                    return;
+                root.startHowdyFace();
+            });
+        }
+    }
+
+    Connections {
+        target: passwd
+
+        function onActiveChanged() {
+            // A manual attempt also reaches Howdy as the fallback; one per wake.
+            if (passwd.active)
+                root.howdyAutoStarted = true;
+        }
+    }
+
